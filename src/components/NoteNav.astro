---
import type { CollectionEntry } from 'astro:content';
import { loadEnv } from "vite";
import Link from '@/components/Link.astro';

const { ASTRO_SITE_URL: SITE_URL, ASTRO_SITE_BASE: SITE_BASE } = loadEnv('development', process.cwd(), 'ASTRO')


export interface Props {
  prev?: CollectionEntry<'problems'>;
  next?: CollectionEntry<'problems'>;
}

const { prev, next } = Astro.props;
---

<nav>
  {prev && (
    <Link class='prev' href={`${SITE_BASE || ''}/problems/${prev.id}/`} rel='prev'>
      <span aria-hidden='true'>←</span>{prev.data.title}
    </Link>
  )}
  {next && (
    <Link class='next' href={`/problems/${next.id}/`} rel='next'>
      {next.data.title}<span aria-hidden='true'>→</span>
    </Link>
  )}
</nav>

<style>
  nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2ch;

    margin-top: 3em;

    hyphens: manual;
  }

  a {
    position: relative;
    max-width: 100%;
    overflow: hidden;

    color: var(--theme-sub-text);
    white-space: nowrap;
    text-overflow: ellipsis;

    &:hover {
      color: var(--theme-text);
    }

    &:focus-visible {
      color: var(--theme-bg);
    }
  }

  span {
    position: absolute;
    inset-block-start: 0;
  }

  .prev {
    justify-self: start;
    padding-inline-start: 2ch;

    span {
      inset-inline-start: 0;
    }
  }

  .next {
    grid-column: 2;
    justify-self: end;
    padding-inline-end: 2ch;

    span {
      inset-inline-end: 0;
    }
  }

  a:only-child {
    grid-column: 1 / -1;
  }
</style>
