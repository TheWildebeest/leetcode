---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
}

console.log(import.meta.env.BASE_URL)

const { 
  href,
  ...rest
} = Astro.props;

const hrefUrl = href.startsWith('http') || href.startsWith('mailto') || href.startsWith('tel') ? href : import.meta.env.BASE_URL + href
console.log(href)
console.log(hrefUrl)
---
<a
  href={hrefUrl}
  {...rest}
>
  <slot />
</a>